{
  "name": "generative-loaders-repository",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build:package": "npm run build --workspace generative-loaders",
    "build": "npm run build:package",
    "typecheck": "tsc -p packages/generative-loaders/tsconfig.build.json --noEmit",
    "test:unit": "vitest run",
    "test": "npm run build:package && npm run typecheck && npm run test:unit",
    "lint": "eslint packages/generative-loaders --ignore-pattern dist",
    "pack:package": "npm pack --workspace generative-loaders --dry-run"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.11.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "jsdom": "^30.1.1",
    "typescript": "7.0.2",
    "typescript-eslint": "8.71.0",
    "vitest": "^5.0.2"
  }
}
