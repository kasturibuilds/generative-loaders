{
  "name": "generative-loaders-repository",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build:package": "npm run build --workspace generative-loaders",
    "build": "npm run build:package",
    "typecheck": "tsc -p packages/generative-loaders/tsconfig.build.json --noEmit",
    "test:unit": "vitest run",
    "test": "npm run build:package && npm run typecheck && npm run test:unit",
    "lint": "eslint packages/generative-loaders --ignore-pattern dist",
    "pack:package": "npm pack --workspace generative-loaders --dry-run"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "jsdom": "^26.1.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vitest": "^4.1.11"
  }
}
